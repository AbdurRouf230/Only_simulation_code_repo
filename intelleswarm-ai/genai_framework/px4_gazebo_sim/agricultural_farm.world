<?xml version="1.0" encoding="UTF-8"?>
<!--
Agricultural Farm World for IntelleSwarm Assistive Pollination Simulation
Gazebo Harmonic (gz sim) SDF 1.9
Features:
- Large farm fields with crop rows
- Flower patches requiring pollination
- Realistic terrain and obstacles
- GPS coordinates for San Francisco area
-->
<sdf version="1.9">
  <world name="agricultural_farm">

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.40 0.18 1</ambient>
            <diffuse>0.30 0.50 0.20 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="corn_field_1">
      <pose>0 100 0.1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>150 80 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.45 0.12 1</ambient>
            <diffuse>0.20 0.55 0.15 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>150 80 0.2</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="soybean_field_1">
      <pose>0 -100 0.1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>150 80 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.28 0.08 1</ambient>
            <diffuse>0.15 0.35 0.10 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>150 80 0.2</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="sunflower_patch_1">
      <pose>50 50 0.2 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>15</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.80 0.65 0.10 1</ambient>
            <diffuse>0.95 0.80 0.15 1</diffuse>
            <specular>0.20 0.20 0.10 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>15</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="sunflower_patch_2">
      <pose>-50 50 0.2 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>12</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.80 0.65 0.10 1</ambient>
            <diffuse>0.95 0.80 0.15 1</diffuse>
            <specular>0.20 0.20 0.10 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>12</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="clover_field">
      <pose>0 0 0.15 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>40 40 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.40 0.18 0.45 1</ambient>
            <diffuse>0.50 0.25 0.55 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>40 40 0.3</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="farm_barn">
      <pose>-150 0 0 0 0 1.57</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>30 15 8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.12 0.08 1</ambient>
            <diffuse>0.70 0.15 0.10 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>30 15 8</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="farm_silo">
      <pose>-130 30 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>5</radius>
              <length>20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.20 0.20 0.20 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>5</radius>
              <length>20</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="tree_line_1">
      <pose>100 0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>3</radius>
              <length>12</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.22 0.10 1</ambient>
            <diffuse>0.45 0.30 0.15 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>3</radius>
              <length>12</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="tree_line_2">
      <pose>100 20 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>3</radius>
              <length>15</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.22 0.10 1</ambient>
            <diffuse>0.45 0.30 0.15 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>3</radius>
              <length>15</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="tree_line_3">
      <pose>100 -20 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>3</radius>
              <length>10</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.22 0.10 1</ambient>
            <diffuse>0.45 0.30 0.15 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>3</radius>
              <length>10</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="fence_post_1">
      <pose>75 75 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.22 0.10 1</ambient>
            <diffuse>0.45 0.30 0.15 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="fence_post_2">
      <pose>-75 75 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.22 0.10 1</ambient>
            <diffuse>0.45 0.30 0.15 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.7749</latitude_deg>
      <longitude_deg>-122.4194</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

  </world>
</sdf>
